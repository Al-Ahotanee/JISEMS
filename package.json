{
  "name": "jisems",
  "version": "2.0.0",
  "description": "JISEMS - Jigawa State Election Monitor Platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "migrate": "npm run migrate --workspace backend",
    "seed": "npm run seed --workspace backend",
    "setup": "npm run setup --workspace backend",
    "test:uat": "node scripts/uat.e2e.js",
    "test:role-matrix": "node scripts/role-matrix.e2e.js",
    "test:socket-hardening": "node scripts/socket-hardening.e2e.js",
    "check": "npm run check --workspace backend && npm run build --workspace frontend"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
